<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.0" />
    <PackageReference Include="Grpc.Core.Api" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\schema\binding\*.proto" ProtoRoot="..\..\.." GrpcServices="Client" />
    <Protobuf Include="..\..\..\schema\extension\capability.proto" ProtoRoot="..\..\.." GrpcServices="None" />
    <Protobuf Include="..\..\..\schema\extension\tool.proto" ProtoRoot="..\..\.." GrpcServices="None" />
    <Protobuf Include="..\..\..\schema\provider\codec.proto" ProtoRoot="..\..\.." GrpcServices="None" />
    <Protobuf Include="..\..\..\schema\provider\connection.proto" ProtoRoot="..\..\.." GrpcServices="None" />
    <Protobuf Include="..\..\..\schema\provider\runtime.proto" ProtoRoot="..\..\.." GrpcServices="None" />
  </ItemGroup>
</Project>
