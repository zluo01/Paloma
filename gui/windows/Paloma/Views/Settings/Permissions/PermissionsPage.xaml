<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Paloma.Views.Settings.Permissions.PermissionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:binding="using:Paloma.Binding.V1"
    xmlns:local="using:Paloma.Views.Settings.Permissions"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="720" Spacing="16">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Permissions" />
            <TextBlock
                Margin="1,-6,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Commands the model may run without asking again."
                TextWrapping="Wrap" />
            <AutoSuggestBox
                Width="320"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                PlaceholderText="Filter permissions"
                QueryIcon="Find"
                TextChanged="OnFilterChanged" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Error" />
            <TextBlock
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.Status, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Permissions, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="binding:Permission">
                        <Grid
                            MinHeight="68"
                            Padding="16,10"
                            Margin="0,0,0,4"
                            ColumnSpacing="16"
                            Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Glyph="{x:Bind local:PermissionsPage.Glyph(Prefix)}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock FontFamily="{StaticResource PalomaMonoFontFamily}" Text="{x:Bind Prefix}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Glob match"
                                    Visibility="{x:Bind WithGlob}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Exact command"
                                    Visibility="{x:Bind WithGlob, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="OnDeleteClick"
                                Content="Remove" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>