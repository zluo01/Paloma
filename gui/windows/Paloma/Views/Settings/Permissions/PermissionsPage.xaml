<?xml version="1.0" encoding="utf-8"?>

<settings:RefreshOnVisiblePage
    x:Class="Paloma.Views.Settings.Permissions.PermissionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Paloma.Views.Settings"
    xmlns:binding="using:PalomaCore"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Paloma.Views.Settings.Permissions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="720" Spacing="16">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Permissions" />
            <TextBlock
                Margin="1,-6,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Commands the model may run without asking again."
                TextWrapping="Wrap" />
            <AutoSuggestBox
                Width="320"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                PlaceholderText="Filter permissions"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Error" />
            <TextBlock
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.Status, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Permissions, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="binding:Permission">
                        <controls:SettingsCard
                            Margin="0,0,0,4"
                            Description="{x:Bind local:PermissionsPage.MatchKind(WithGlob)}"
                            HeaderIcon="{x:Bind local:PermissionsPage.Icon(Prefix)}">
                            <controls:SettingsCard.Header>
                                <TextBlock FontFamily="{StaticResource PalomaMonoFontFamily}" Text="{x:Bind Prefix}" />
                            </controls:SettingsCard.Header>
                            <Button Click="OnDeleteClick" Content="Remove" />
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</settings:RefreshOnVisiblePage>
