<?xml version="1.0" encoding="utf-8"?>

<ContentDialog
    x:Class="Paloma.Views.Settings.Plugins.PluginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Paloma.ViewModels.Settings"
    Title="{x:Bind ViewModel.Title}"
    CloseButtonText="Cancel"
    Closing="{x:Bind ViewModel.Cancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryLabel}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <DataTemplate x:Key="FieldHeader">
            <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="{Binding}" />
        </DataTemplate>

        <DataTemplate x:Key="KeyValueRow" x:DataType="viewmodels:KeyValueRow">
            <StackPanel Margin="0,0,0,8" Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        AutomationProperties.Name="Name"
                        FontFamily="{StaticResource PalomaMonoFontFamily}"
                        PlaceholderText="Name"
                        Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Grid.Column="1"
                        AutomationProperties.Name="Value"
                        FontFamily="{StaticResource PalomaMonoFontFamily}"
                        PlaceholderText="Value"
                        Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Remove"
                        Click="{x:Bind Remove}"
                        Style="{StaticResource IconButton}"
                        ToolTipService.ToolTip="Remove">
                        <FontIcon FontSize="13" Glyph="&#xE74D;" />
                    </Button>
                </Grid>
                <TextBlock
                    Style="{StaticResource FieldError}"
                    Text="Another row already uses this name."
                    Visibility="{x:Bind IsDuplicate, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid Width="400">
        <Grid Visibility="{x:Bind ViewModel.Authorizing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasSubmitError, Mode=OneWay}"
                Message="{x:Bind ViewModel.SubmitError, Mode=OneWay}"
                Severity="Error"
                Title="{x:Bind ViewModel.SubmitErrorTitle}" />
            <ScrollViewer
                Grid.Row="1"
                Margin="-24,0"
                Padding="24,0"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsMcp}">
                        <TextBox
                            Header="Name"
                            IsEnabled="{x:Bind ViewModel.NameEditable}"
                            PlaceholderText="my-server"
                            Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Style="{StaticResource FieldError}"
                            Text="{x:Bind ViewModel.NameError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.NameError, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />
                    </StackPanel>

                    <RadioButtons
                        Header="Type"
                        MaxColumns="2"
                        SelectedIndex="{x:Bind ViewModel.TypeIndex, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsMcp}">
                        <RadioButton Content="Local command" />
                        <RadioButton Content="Remote server" />
                    </RadioButtons>

                    <TextBox
                        FontFamily="{StaticResource PalomaMonoFontFamily}"
                        Header="Command"
                        HeaderTemplate="{StaticResource FieldHeader}"
                        PlaceholderText="{x:Bind ViewModel.CommandPlaceholder}"
                        Text="{x:Bind ViewModel.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.IsLocal, Mode=OneWay}" />

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsLocal, Mode=OneWay}">
                        <TextBox
                            FontFamily="{StaticResource PalomaMonoFontFamily}"
                            Header="Arguments"
                            HeaderTemplate="{StaticResource FieldHeader}"
                            PlaceholderText="[&quot;--flag&quot;, &quot;value&quot;]"
                            Text="{x:Bind ViewModel.Args, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Style="{StaticResource FieldError}"
                            Text="{x:Bind ViewModel.ArgsError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ArgsError, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />
                    </StackPanel>

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsRemote, Mode=OneWay}">
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="URL"
                                PlaceholderText="https://example.com/mcp"
                                Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Style="{StaticResource FieldError}"
                                Text="{x:Bind ViewModel.UrlError, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.UrlError, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />
                        </StackPanel>

                        <ComboBox
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Label"
                            Header="Authentication"
                            HeaderTemplate="{StaticResource FieldHeader}"
                            ItemsSource="{x:Bind viewmodels:PluginDialogViewModel.AuthOptions}"
                            SelectedItem="{x:Bind ViewModel.Auth, Mode=TwoWay}" />

                        <PasswordBox
                            Header="Token"
                            Password="{x:Bind ViewModel.Token, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.IsBearerAuth, Mode=OneWay}" />

                        <StackPanel Visibility="{x:Bind ViewModel.IsHeadersAuth, Mode=OneWay}">
                            <TextBlock Margin="0,0,0,8" Text="Headers" />
                            <ItemsControl ItemTemplate="{StaticResource KeyValueRow}" ItemsSource="{x:Bind ViewModel.Headers}" />
                            <Button
                                HorizontalAlignment="Left"
                                Click="{x:Bind ViewModel.AddHeader}"
                                Content="Add header" />
                        </StackPanel>

                        <TextBox
                            Header="Client ID"
                            Text="{x:Bind ViewModel.ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{x:Bind ViewModel.IsOauthClientAuth, Mode=OneWay}" />
                    </StackPanel>

                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Header="Advanced"
                        IsExpanded="{x:Bind ViewModel.AdvancedExpanded, Mode=TwoWay}">
                        <StackPanel Spacing="12">
                            <NumberBox
                                Header="Timeout (seconds)"
                                Maximum="3600"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.Timeout, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.IsMcp}" />
                            <StackPanel>
                                <TextBlock Margin="0,0,0,8" Text="Environment" />
                                <ItemsControl ItemTemplate="{StaticResource KeyValueRow}" ItemsSource="{x:Bind ViewModel.Env}" />
                                <Button
                                    HorizontalAlignment="Left"
                                    Click="{x:Bind ViewModel.AddVariable}"
                                    Content="Add variable" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Authorizing, Mode=OneWay}">
            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Waiting for authorization" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Approve the connection in your browser to finish adding this server."
                TextWrapping="Wrap" />
            <HyperlinkButton
                Padding="0"
                Content="Open the authorization page"
                NavigateUri="{x:Bind ViewModel.AuthUri, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.Authorizing, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Listening for the response…" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>
