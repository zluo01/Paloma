<?xml version="1.0" encoding="utf-8"?>

<settings:RefreshOnVisiblePage
    x:Class="Paloma.Views.Settings.Plugins.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Paloma.Views.Settings"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Paloma.ViewModels.Settings"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.SettingsControls/SettingsExpander/SettingsExpander.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Thickness x:Key="SettingsExpanderItemPadding">16,8,44,8</Thickness>

            <DataTemplate x:Key="PluginDescription" x:DataType="viewmodels:PluginViewModel">
                <StackPanel Spacing="2">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Description}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Error}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Error, Converter={StaticResource EmptyToCollapsed}}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="PluginActions" x:DataType="viewmodels:PluginViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind HealthLabel}"
                        Visibility="{x:Bind HealthLabel, Converter={StaticResource EmptyToCollapsed}}" />
                    <Button
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Edit"
                        Click="OnEditPlugin"
                        Style="{StaticResource IconButton}"
                        ToolTipService.ToolTip="Edit"
                        Visibility="{x:Bind CanManage}">
                        <FontIcon FontSize="13" Glyph="&#xE70F;" />
                    </Button>
                    <Button
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Remove"
                        Click="OnRemovePlugin"
                        Style="{StaticResource IconButton}"
                        ToolTipService.ToolTip="Remove"
                        Visibility="{x:Bind CanManage}">
                        <FontIcon FontSize="13" Glyph="&#xE74D;" />
                    </Button>
                    <ToggleSwitch
                        MinWidth="0"
                        VerticalAlignment="Center"
                        IsOn="{x:Bind Enabled, Mode=TwoWay}"
                        OffContent=""
                        OnContent=""
                        Visibility="{x:Bind CanManage}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ProviderTemplate" x:DataType="viewmodels:PluginViewModel">
                <controls:SettingsCard Margin="0,0,0,8" Header="{x:Bind Name}">
                    <controls:SettingsCard.Description>
                        <ContentPresenter Content="{x:Bind}" ContentTemplate="{StaticResource PluginDescription}" />
                    </controls:SettingsCard.Description>
                    <ContentPresenter Content="{x:Bind}" ContentTemplate="{StaticResource PluginActions}" />
                </controls:SettingsCard>
            </DataTemplate>

            <DataTemplate x:Key="CapabilityTemplate" x:DataType="viewmodels:CapabilityToggleViewModel">
                <controls:SettingsCard
                    Description="{x:Bind Description}"
                    Header="{x:Bind Id}"
                    Style="{StaticResource DefaultSettingsExpanderItemStyle}">
                    <ToggleSwitch
                        MinWidth="0"
                        IsOn="{x:Bind Enabled, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                </controls:SettingsCard>
            </DataTemplate>

            <DataTemplate x:Key="ExtensionTemplate" x:DataType="viewmodels:ExtensionViewModel">
                <controls:SettingsExpander Margin="0,0,0,8" Header="{x:Bind Name}">
                    <controls:SettingsExpander.Description>
                        <ContentPresenter Content="{x:Bind}" ContentTemplate="{StaticResource PluginDescription}" />
                    </controls:SettingsExpander.Description>
                    <ContentPresenter Content="{x:Bind}" ContentTemplate="{StaticResource PluginActions}" />
                    <controls:SettingsExpander.ItemsHeader>
                        <StackPanel>
                            <TextBlock
                                Padding="16,12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="No capabilities available."
                                Visibility="{x:Bind HasCapabilities, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock
                                Padding="16,12,16,4"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="Search"
                                Visibility="{x:Bind HasSearchCapabilities}" />
                            <ItemsControl
                                IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                                ItemTemplate="{StaticResource CapabilityTemplate}"
                                ItemsSource="{x:Bind SearchCapabilities}"
                                Visibility="{x:Bind HasSearchCapabilities}" />
                            <TextBlock
                                Padding="16,12,16,4"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="Tools"
                                Visibility="{x:Bind HasToolCapabilities}" />
                            <ItemsControl
                                IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                                ItemTemplate="{StaticResource CapabilityTemplate}"
                                ItemsSource="{x:Bind ToolCapabilities}"
                                Visibility="{x:Bind HasToolCapabilities}" />
                        </StackPanel>
                    </controls:SettingsExpander.ItemsHeader>
                </controls:SettingsExpander>
            </DataTemplate>

            <DataTemplate x:Key="McpTemplate" x:DataType="viewmodels:McpViewModel">
                <controls:SettingsExpander Margin="0,0,0,8" Header="{x:Bind Name}">
                    <controls:SettingsExpander.Description>
                        <ContentPresenter Content="{x:Bind}" ContentTemplate="{StaticResource PluginDescription}" />
                    </controls:SettingsExpander.Description>
                    <ContentPresenter Content="{x:Bind}" ContentTemplate="{StaticResource PluginActions}" />
                    <controls:SettingsExpander.ItemsHeader>
                        <StackPanel>
                            <TextBlock
                                Padding="16,12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="No tools available."
                                Visibility="{x:Bind HasTools, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ItemsControl
                                IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                                ItemTemplate="{StaticResource CapabilityTemplate}"
                                ItemsSource="{x:Bind Tools}"
                                Visibility="{x:Bind HasTools}" />
                        </StackPanel>
                    </controls:SettingsExpander.ItemsHeader>
                </controls:SettingsExpander>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="720" Spacing="16">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="Plugins" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.Status, Mode=OneWay}"
                Severity="Error" />

            <Grid Style="{StaticResource SettingsSectionHeaderPanel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Extensions" />
                <Button
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    AutomationProperties.Name="Add extension"
                    Click="OnAddExtension"
                    Style="{StaticResource IconButton}"
                    ToolTipService.ToolTip="Add an extension">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                </Button>
            </Grid>
            <ItemsControl ItemTemplate="{StaticResource ExtensionTemplate}"
                          ItemsSource="{x:Bind ViewModel.Extensions, Mode=OneWay}" />

            <Grid Style="{StaticResource SettingsSectionHeaderPanel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Providers" />
                <Button
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    AutomationProperties.Name="Add provider"
                    Click="OnAddProvider"
                    Style="{StaticResource IconButton}"
                    ToolTipService.ToolTip="Add a provider">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                </Button>
            </Grid>
            <ItemsControl ItemTemplate="{StaticResource ProviderTemplate}"
                          ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}" />

            <Grid Style="{StaticResource SettingsSectionHeaderPanel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="MCP Servers" />
                <Button
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    AutomationProperties.Name="Add MCP server"
                    Click="OnAddMcp"
                    Style="{StaticResource IconButton}"
                    ToolTipService.ToolTip="Add an MCP server">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                </Button>
            </Grid>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No MCP servers configured."
                Visibility="{x:Bind ViewModel.HasMcps, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemTemplate="{StaticResource McpTemplate}"
                          ItemsSource="{x:Bind ViewModel.Mcps, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</settings:RefreshOnVisiblePage>
