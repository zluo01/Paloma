<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Paloma.Views.Settings.Shortcuts.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Paloma.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardMinHeight">44</x:Double>
        <DataTemplate x:Key="ShortcutTemplate" x:DataType="models:Shortcut">
            <controls:SettingsCard Header="{x:Bind Description}">
                <ItemsControl ItemsSource="{x:Bind Keys}" Style="{StaticResource KeyCaps}" />
            </controls:SettingsCard>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="CardStack">
            <StackPanel Spacing="4" />
        </ItemsPanelTemplate>
        <Style x:Key="ShortcutList" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource ShortcutTemplate}" />
            <Setter Property="ItemsPanel" Value="{StaticResource CardStack}" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="720" Spacing="16">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Shortcuts" />
            <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Global" />
            <ItemsControl ItemsSource="{x:Bind models:Shortcuts.Global}" Style="{StaticResource ShortcutList}" />

            <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Search" />
            <ItemsControl ItemsSource="{x:Bind models:Shortcuts.Search}" Style="{StaticResource ShortcutList}" />

            <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Chat" />
            <ItemsControl ItemsSource="{x:Bind models:Shortcuts.Chat}" Style="{StaticResource ShortcutList}" />

            <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Sessions" />
            <ItemsControl ItemsSource="{x:Bind models:Shortcuts.Sessions}" Style="{StaticResource ShortcutList}" />
        </StackPanel>
    </ScrollViewer>
</Page>
