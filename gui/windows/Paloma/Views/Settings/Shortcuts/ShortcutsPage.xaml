<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Paloma.Views.Settings.Shortcuts.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Paloma.Views.Settings.Shortcuts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="KeyTemplate" x:DataType="x:String">
            <ContentControl Content="{x:Bind}" Style="{StaticResource KeyCap}" />
        </DataTemplate>
        <DataTemplate x:Key="ShortcutTemplate" x:DataType="local:ShortcutEntry">
            <Grid Padding="16,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{x:Bind Description}" />
                <ItemsControl
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    ItemTemplate="{StaticResource KeyTemplate}"
                    ItemsSource="{x:Bind Keys}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </DataTemplate>
        <Style x:Key="SectionCard" TargetType="ItemsControl">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="ItemTemplate" Value="{StaticResource ShortcutTemplate}" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="720" Spacing="16">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Shortcuts" />
            <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Search" />
            <ItemsControl ItemsSource="{x:Bind Search}" Style="{StaticResource SectionCard}" />

            <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Chat" />
            <ItemsControl ItemsSource="{x:Bind Chat}" Style="{StaticResource SectionCard}" />

            <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Sessions" />
            <ItemsControl ItemsSource="{x:Bind Sessions}" Style="{StaticResource SectionCard}" />
        </StackPanel>
    </ScrollViewer>
</Page>