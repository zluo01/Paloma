<?xml version="1.0" encoding="utf-8"?>

<settings:RefreshOnVisiblePage
    x:Class="Paloma.Views.Settings.Services.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Paloma.Views.Settings"
    xmlns:binding="using:PalomaCore"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:Paloma.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Paloma.ViewModels.Settings"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardHeaderIconMaxSize">32</x:Double>
    </Page.Resources>

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="720" Spacing="16">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Services" />

            <StackPanel
                Margin="0,8,0,0"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.Loading, Mode=OneWay}">
                <ProgressRing
                    Width="18"
                    Height="18"
                    IsActive="{x:Bind ViewModel.Loading, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Loading services…" />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Error" />

            <TextBlock
                Style="{StaticResource SettingsSectionHeader}"
                Text="Connected"
                Visibility="{x:Bind ViewModel.Ready, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No services connected."
                Visibility="{x:Bind ViewModel.ShowNoConnected, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Connected, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:ConnectorViewModel">
                        <StackPanel Margin="0,0,0,8" Spacing="8">
                            <controls:SettingsCard
                                Description="{x:Bind Description}"
                                Header="{x:Bind BackendLabel}"
                                HeaderIcon="{x:Bind Icon, Converter={StaticResource IconToIconElement}}">
                                <Button Command="{x:Bind DisconnectCommand}" Content="Disconnect" />
                            </controls:SettingsCard>
                            <InfoBar
                                IsClosable="False"
                                IsOpen="{x:Bind HasError}"
                                Message="{x:Bind Error}"
                                Severity="Error"
                                Visibility="{x:Bind HasError}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Style="{StaticResource SettingsSectionHeader}"
                Text="Available"
                Visibility="{x:Bind ViewModel.Ready, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="All supported services are connected."
                Visibility="{x:Bind ViewModel.ShowNoAvailable, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Available, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="binding:Connector">
                        <controls:SettingsCard
                            Margin="0,0,0,8"
                            Description="{x:Bind Description}"
                            Header="{x:Bind extensions:Display.Backend(Id)}"
                            HeaderIcon="{x:Bind Icon, Converter={StaticResource IconToIconElement}}">
                            <Button Click="OnConnectClick" Content="Connect" />
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</settings:RefreshOnVisiblePage>
