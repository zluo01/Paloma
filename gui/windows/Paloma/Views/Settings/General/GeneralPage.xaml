<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Paloma.Views.Settings.General.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="720" Spacing="16">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="General" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Error" />
            <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Startup" />
            <controls:SettingsCard Description="Start Paloma automatically when you sign in" Header="Launch at login">
                <ToggleSwitch
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.AutostartEnabled, Mode=TwoWay}"
                    OffContent=""
                    OnContent="" />
            </controls:SettingsCard>

            <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Shortcut" />
            <controls:SettingsCard Description="Summon or dismiss the launcher from anywhere" Header="Toggle Paloma">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            FontFamily="{StaticResource PalomaMonoFontFamily}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.ShortcutLabel, Mode=OneWay}" />
                    </Border>
                    <ToggleButton
                        x:Name="RecordButton"
                        VerticalAlignment="Center"
                        Checked="OnRecordChecked"
                        Content="Record"
                        LostFocus="OnRecordLostFocus"
                        PreviewKeyDown="OnRecordKeyDown"
                        Unchecked="OnRecordUnchecked" />
                </StackPanel>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
