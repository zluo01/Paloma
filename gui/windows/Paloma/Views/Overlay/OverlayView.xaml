<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Paloma.Views.Overlay.OverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chat="using:Paloma.Views.Overlay.Chat"
    xmlns:extensions="using:Paloma.Extensions"
    xmlns:footer="using:Paloma.Views.Overlay.Footer"
    xmlns:local="using:Paloma.Views.Overlay"
    xmlns:search="using:Paloma.Views.Overlay.Search"
    xmlns:sessions="using:Paloma.Views.Overlay.Sessions"
    Loaded="OnLoaded">

    <Grid PreviewKeyDown="OnPreviewKeyDown" SizeChanged="OnSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="HeaderBar"
            Grid.Row="0"
            Height="56"
            Padding="18,0"
            ColumnSpacing="12"
            SizeChanged="OnSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="20"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="{x:Bind extensions:Display.Glyph(Mode), Mode=OneWay}" />
            <TextBox
                x:Name="Input"
                Grid.Column="1"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                FontSize="20"
                PlaceholderText="{x:Bind extensions:Display.Placeholder(Mode), Mode=OneWay}"
                SizeChanged="OnSizeChanged"
                TextChanged="OnInputChanged">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                </TextBox.Resources>
            </TextBox>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="12,8,12,0"
            Padding="12,8"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}">
            <TextBlock
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
        </Border>

        <chat:ChatView
            x:Name="Chat"
            Grid.Row="2"
            DecisionHandled="OnChatDecisionHandled"
            Visibility="{x:Bind local:OverlayView.WhenChat(Mode), Mode=OneWay}" />

        <sessions:SessionsView
            x:Name="SessionsPanel"
            Grid.Row="2"
            RowActivated="OnSessionRowActivated"
            Visibility="{x:Bind local:OverlayView.WhenSessions(Mode), Mode=OneWay}" />

        <search:SearchView
            x:Name="SearchPanel"
            Grid.Row="2"
            ActionCompleted="OnSearchActionCompleted"
            ActionsFlyoutClosed="OnSearchActionsFlyoutClosed"
            AskRequested="OnSearchAskRequested"
            Visibility="{x:Bind local:OverlayView.WhenSearch(Mode), Mode=OneWay}" />

        <footer:FooterView
            x:Name="FooterPanel"
            Grid.Row="3"
            Mode="{x:Bind Mode, Mode=OneWay}"
            ModelFlyoutClosed="OnModelFlyoutClosed"
            SessionsRequested="OnFooterSessionsRequested"
            SizeChanged="OnSizeChanged" />
    </Grid>
</UserControl>