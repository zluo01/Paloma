<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Paloma.Views.Overlay.OverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chat="using:Paloma.Views.Overlay.Chat"
    xmlns:footer="using:Paloma.Views.Overlay.Footer"
    xmlns:local="using:Paloma.Views.Overlay"
    xmlns:query="using:Paloma.Views.Overlay.Query"
    xmlns:search="using:Paloma.Views.Overlay.Search"
    xmlns:sessions="using:Paloma.Views.Overlay.Sessions"
    Loaded="OnLoaded">

    <Grid PreviewKeyDown="OnPreviewKeyDown" SizeChanged="OnSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <query:QueryView
            x:Name="Query"
            x:FieldModifier="internal"
            Grid.Row="0"
            Mode="{x:Bind Mode, Mode=OneWay}"
            SizeChanged="OnSizeChanged"
            TextChanged="OnQueryChanged" />

        <Border
            Grid.Row="1"
            Margin="12,8,12,0"
            Padding="12,8"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}">
            <TextBlock
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
        </Border>

        <chat:ChatView
            x:Name="Chat"
            Grid.Row="2"
            DecisionHandled="OnChatDecisionHandled"
            Visibility="{x:Bind local:OverlayView.WhenChat(Mode), Mode=OneWay}" />

        <sessions:SessionsView
            x:Name="SessionsPanel"
            Grid.Row="2"
            RowActivated="OnSessionRowActivated"
            Visibility="{x:Bind local:OverlayView.WhenSessions(Mode), Mode=OneWay}" />

        <search:SearchView
            x:Name="SearchPanel"
            Grid.Row="2"
            ActionCompleted="OnSearchActionCompleted"
            ActionsFlyoutClosed="OnSearchActionsFlyoutClosed"
            AskRequested="OnSearchAskRequested"
            Visibility="{x:Bind local:OverlayView.WhenSearch(Mode), Mode=OneWay}" />

        <footer:FooterView
            x:Name="FooterPanel"
            Grid.Row="3"
            HasResults="{x:Bind Search.HasResults, Mode=OneWay}"
            Mode="{x:Bind Mode, Mode=OneWay}"
            ModelFlyoutClosed="OnModelFlyoutClosed"
            SessionsRequested="OnFooterSessionsRequested"
            SizeChanged="OnSizeChanged"
            StopRequested="OnFooterStopRequested"
            Streaming="{x:Bind Chat.ViewModel.Streaming, Mode=OneWay}" />
    </Grid>
</UserControl>