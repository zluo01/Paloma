<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Paloma.Views.Overlay.Footer.FooterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Paloma.Views.Overlay.Footer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Paloma.Models"
    xmlns:overlay="using:Paloma.Views.Overlay"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="FooterHint"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid
        Padding="14,7"
        Background="Transparent"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid Visibility="{x:Bind overlay:OverlayView.WhenSearch(Mode), Mode=OneWay}">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="{x:Bind HasResults, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind ViewModel.ServicesHealth, Mode=OneWay, Converter={StaticResource HealthToLabel}, ConverterParameter=Services}"
                        Orientation="Horizontal"
                        Spacing="5"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ServicesHealth, Mode=OneWay, Converter={StaticResource HealthToLabel}, ConverterParameter=Services}">
                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{x:Bind local:FooterView.HealthBrush(ViewModel.ServicesHealth), Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Services" />
                    </StackPanel>
                    <StackPanel
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind ViewModel.PluginsHealth, Mode=OneWay, Converter={StaticResource HealthToLabel}, ConverterParameter=Plugins}"
                        Orientation="Horizontal"
                        Spacing="5"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PluginsHealth, Mode=OneWay, Converter={StaticResource HealthToLabel}, ConverterParameter=Plugins}">
                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{x:Bind local:FooterView.HealthBrush(ViewModel.PluginsHealth), Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Plugins" />
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind HasResults, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource FooterHint}" Text="Submit" />
                        <ItemsControl ItemsSource="{x:Bind models:Shortcuts.Submit.Keys}"
                                      Style="{StaticResource KeyCaps}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource FooterHint}" Text="Show actions" />
                        <ItemsControl ItemsSource="{x:Bind models:Shortcuts.ShowActions.Keys}"
                                      Style="{StaticResource KeyCaps}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind overlay:OverlayView.WhenChat(Mode), Mode=OneWay}">
                <TextBlock Style="{StaticResource FooterHint}" Text="Scroll by page" />
                <ItemsControl ItemsSource="{x:Bind models:Shortcuts.ScrollByPage.Keys}"
                              Style="{StaticResource KeyCaps}" />
            </StackPanel>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="{x:Bind overlay:OverlayView.WhenSessions(Mode), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource FooterHint}" Text="Open session" />
                    <ItemsControl ItemsSource="{x:Bind models:Shortcuts.OpenSession.Keys}"
                                  Style="{StaticResource KeyCaps}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource FooterHint}" Text="Delete session" />
                    <ItemsControl ItemsSource="{x:Bind models:Shortcuts.DeleteSession.Keys}"
                                  Style="{StaticResource KeyCaps}" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid x:Name="ActionsPanel" Grid.Column="2">
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                Visibility="{x:Bind Streaming, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <DropDownButton
                    x:Name="ModelButton"
                    MinHeight="30"
                    Padding="9,3"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="{x:Bind ViewModel.ModelLabel, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsEnabled="{x:Bind ViewModel.HasSelectableProvider, Mode=OneWay}"
                    ToolTipService.ToolTip="Preferred model">
                    <DropDownButton.Flyout>
                        <!--  https://github.com/microsoft/microsoft-ui-xaml/issues/7384  -->
                        <MenuFlyout
                            x:Name="ModelFlyout"
                            Closed="OnModelFlyoutClosed"
                            Opening="OnModelFlyoutOpening"
                            Placement="Top" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button
                    x:Name="SettingsButton"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Settings"
                    Click="OnSettingsClick"
                    Style="{StaticResource IconButton}"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
                <Button
                    x:Name="SessionsButton"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Sessions"
                    Click="OnSessionsClick"
                    Style="{StaticResource IconButton}"
                    ToolTipService.ToolTip="{x:Bind models:Shortcuts.OpenSessions.Label}">
                    <FontIcon FontSize="14" Glyph="&#xE81C;" />
                </Button>
            </StackPanel>
            <Button
                x:Name="StopButton"
                MinHeight="30"
                Padding="9,3"
                VerticalAlignment="Center"
                AllowFocusOnInteraction="False"
                AutomationProperties.Name="Stop"
                Click="OnStopClick"
                FontSize="12"
                ToolTipService.ToolTip="{x:Bind models:Shortcuts.Interrupt.Label}"
                Visibility="{x:Bind Streaming, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xE73B;" />
                    <TextBlock VerticalAlignment="Center" Text="Stop" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>