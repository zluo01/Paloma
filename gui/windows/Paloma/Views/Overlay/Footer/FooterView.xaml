<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Paloma.Views.Overlay.Footer.FooterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Paloma.Views.Overlay.Footer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:overlay="using:Paloma.Views.Overlay"
    mc:Ignorable="d">

    <Grid
        Padding="14,7"
        Background="Transparent"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Column="0"
            VerticalAlignment="Center"
            AutomationProperties.Name="{x:Bind ViewModel.ServicesHealth, Mode=OneWay, Converter={StaticResource HealthToLabel}, ConverterParameter=Services}"
            Orientation="Horizontal"
            Spacing="5"
            ToolTipService.ToolTip="{x:Bind ViewModel.ServicesHealth, Mode=OneWay, Converter={StaticResource HealthToLabel}, ConverterParameter=Services}">
            <Ellipse
                Width="8"
                Height="8"
                VerticalAlignment="Center"
                Fill="{x:Bind local:FooterView.HealthBrush(ViewModel.ServicesHealth), Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Services" />
        </StackPanel>
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            AutomationProperties.Name="{x:Bind ViewModel.PluginsHealth, Mode=OneWay, Converter={StaticResource HealthToLabel}, ConverterParameter=Plugins}"
            Orientation="Horizontal"
            Spacing="5"
            ToolTipService.ToolTip="{x:Bind ViewModel.PluginsHealth, Mode=OneWay, Converter={StaticResource HealthToLabel}, ConverterParameter=Plugins}">
            <Ellipse
                Width="8"
                Height="8"
                VerticalAlignment="Center"
                Fill="{x:Bind local:FooterView.HealthBrush(ViewModel.PluginsHealth), Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Plugins" />
        </StackPanel>
        <Grid Grid.Column="2">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="{x:Bind overlay:OverlayView.WhenSearch(Mode), Mode=OneWay}">
                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Shift+↓" />
                <Run Text="sessions" />
            </TextBlock>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="{x:Bind overlay:OverlayView.WhenChat(Mode), Mode=OneWay}">
                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Ctrl+C" />
                <Run Text="stop" />
                <Run Text=" · " />
                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Shift+↓" />
                <Run Text="sessions" />
            </TextBlock>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="{x:Bind overlay:OverlayView.WhenSessions(Mode), Mode=OneWay}">
                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Enter" />
                <Run Text="restore" />
                <Run Text=" · " />
                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Del" />
                <Run Text="delete" />
            </TextBlock>
        </Grid>
        <DropDownButton
            x:Name="ModelButton"
            Grid.Column="3"
            MinHeight="30"
            Padding="9,3"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Content="{x:Bind ViewModel.ModelLabel, Mode=OneWay}"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsEnabled="{x:Bind ViewModel.HasSelectableProvider, Mode=OneWay}"
            ToolTipService.ToolTip="Preferred model">
            <DropDownButton.Flyout>
                <!--  https://github.com/microsoft/microsoft-ui-xaml/issues/7384  -->
                <MenuFlyout
                    x:Name="ModelFlyout"
                    Closed="OnModelFlyoutClosed"
                    Opening="OnModelFlyoutOpening"
                    Placement="Top" />
            </DropDownButton.Flyout>
        </DropDownButton>
        <Button
            x:Name="SettingsButton"
            Grid.Column="4"
            VerticalAlignment="Center"
            AutomationProperties.Name="Settings"
            Click="OnSettingsClick"
            Style="{StaticResource IconButton}"
            ToolTipService.ToolTip="Settings">
            <FontIcon FontSize="14" Glyph="&#xE713;" />
        </Button>
        <Button
            x:Name="SessionsButton"
            Grid.Column="5"
            VerticalAlignment="Center"
            AutomationProperties.Name="Sessions"
            Click="OnSessionsClick"
            Style="{StaticResource IconButton}"
            ToolTipService.ToolTip="Sessions (Shift+↓)">
            <FontIcon FontSize="14" Glyph="&#xE81C;" />
        </Button>
    </Grid>
</UserControl>