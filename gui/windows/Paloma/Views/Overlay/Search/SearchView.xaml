<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Paloma.Views.Overlay.Search.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Paloma.Views.Overlay.Shared"
    xmlns:viewmodels="using:Paloma.ViewModels.Overlay">

    <UserControl.Resources>
        <MenuFlyout
            x:Name="ActionsFlyout"
            Closed="OnActionsFlyoutClosed"
            Placement="BottomEdgeAlignedRight">
            <MenuFlyout.MenuFlyoutPresenterStyle>
                <Style BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}" TargetType="MenuFlyoutPresenter">
                    <Setter Property="MinWidth" Value="180" />
                </Style>
            </MenuFlyout.MenuFlyoutPresenterStyle>
        </MenuFlyout>
        <Style
            x:Key="ActionMenuItem"
            BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}"
            TargetType="MenuFlyoutItem">
            <Setter Property="FocusVisualPrimaryThickness" Value="1" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="ResultsScroller"
        Padding="8,0,8,6"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ItemsControl x:Name="GroupsItems" ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:SearchGroup">
                        <StackPanel>
                            <TextBlock
                                Padding="12,10,12,4"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Name}" />
                            <ItemsControl ItemsSource="{x:Bind Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:LauncherRow">
                                        <shared:RowItem Hovered="{x:Bind IsHovered, Mode=TwoWay}"
                                                        RightTapped="OnRowRightTapped"
                                                        Selected="{x:Bind IsSelected, Mode=OneWay}"
                                                        Tapped="OnRowTapped">
                                            <Grid Padding="12,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter
                                                    Width="24"
                                                    Height="24"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Content="{x:Bind Icon, Mode=OneWay}"
                                                    Visibility="{x:Bind ShowsIcon}" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="1">
                                                    <TextBlock
                                                        MaxLines="1"
                                                        Style="{ThemeResource BodyTextBlockStyle}"
                                                        Text="{x:Bind Item.Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        MaxLines="1"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Item.Subtitle}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{x:Bind Item.Subtitle, Converter={StaticResource EmptyToCollapsed}}" />
                                                </StackPanel>
                                                <Border
                                                    Grid.Column="2"
                                                    Margin="10,0,0,0"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                                    Visibility="{x:Bind ShowActionHint, Mode=OneWay}">
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        Text="Ctrl+Enter" />
                                                </Border>
                                                <Button
                                                    Grid.Column="2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="More actions"
                                                    Click="OnRowMoreClick"
                                                    Style="{StaticResource IconButton}"
                                                    Tapped="OnRowMoreTapped"
                                                    ToolTipService.ToolTip="Actions"
                                                    Visibility="{x:Bind ShowMoreButton, Mode=OneWay}">
                                                    <FontIcon FontSize="13" Glyph="&#xE712;" />
                                                </Button>
                                            </Grid>
                                        </shared:RowItem>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}">
                <Border
                    Height="1"
                    Margin="12,6,12,2"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <shared:RowItem Selected="{x:Bind ViewModel.AskSelected, Mode=OneWay}" Tapped="OnAskTapped">
                    <Grid Padding="12,7" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Width="24"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE8BD;" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Ask Paloma" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.Query, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </shared:RowItem>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>