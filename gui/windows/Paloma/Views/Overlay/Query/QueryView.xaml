<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Paloma.Views.Overlay.Query.QueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:extensions="using:Paloma.Extensions">

    <Grid Padding="18,12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon
            Grid.Column="0"
            Margin="0,3,0,0"
            VerticalAlignment="Top"
            FontSize="20"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Glyph="{x:Bind extensions:Display.Glyph(Mode), Mode=OneWay}" />
        <RichEditBox
            x:Name="Input"
            Grid.Column="1"
            MaxHeight="160"
            Padding="0"
            VerticalAlignment="Top"
            AllowDrop="True"
            Background="Transparent"
            BorderThickness="0"
            ClipboardCopyFormat="PlainText"
            DisabledFormattingAccelerators="All"
            DragOver="OnInputDragOver"
            Drop="OnInputDrop"
            FontSize="20"
            Paste="OnInputPaste"
            PlaceholderText="{x:Bind extensions:Display.Placeholder(Mode), Mode=OneWay}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SizeChanged="OnInputSizeChanged"
            TextChanged="OnInputChanged"
            TextWrapping="Wrap">
            <RichEditBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            </RichEditBox.Resources>
        </RichEditBox>
    </Grid>
</UserControl>
