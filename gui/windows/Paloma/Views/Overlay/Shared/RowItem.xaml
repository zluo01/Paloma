<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Paloma.Views.Overlay.Shared.RowItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    mc:Ignorable="d">

    <!--  Transparent, not unset: empty row areas must stay hit-testable
          for the Tapped handlers consumers attach.  -->
    <Grid Background="Transparent" CornerRadius="{StaticResource RowCornerRadius}">
        <Border
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="{StaticResource RowCornerRadius}"
            IsHitTestVisible="False"
            Visibility="{x:Bind Selected, Mode=OneWay}" />
        <Border
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="{StaticResource RowCornerRadius}"
            IsHitTestVisible="False"
            Visibility="{x:Bind Hovered, Mode=OneWay}" />
        <Border
            Width="3"
            Height="16"
            Margin="1,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            CornerRadius="1.5"
            Visibility="{x:Bind Selected, Mode=OneWay}" />
        <ContentPresenter Content="{x:Bind Row, Mode=OneWay}" />
    </Grid>
</UserControl>