<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Paloma.Views.Overlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Paloma.Views.Overlay"
    Title="Paloma">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <local:OverlayView
        x:Name="Overlay"
        DragRegionsChanged="OnDragRegionsChanged"
        HideRequested="Hide"
        ModeChanged="ResizeWindow" />
</Window>