<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="ScryPluginDialog" parent="AdwDialog">
    <property name="content-width">440</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-start-title-buttons">false</property>
            <property name="show-end-title-buttons">false</property>
            <child type="start">
              <object class="GtkButton" id="cancel">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="add">
                <property name="sensitive">false</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="AdwBanner" id="banner">
                <property name="button-label">Dismiss</property>
              </object>
            </child>
            <child>
              <object class="GtkListBox">
                <property name="selection-mode">none</property>
                <property name="margin-top">12</property>
                <property name="margin-bottom">24</property>
                <property name="margin-start">24</property>
                <property name="margin-end">24</property>
                <style>
                  <class name="boxed-list"/>
                </style>
                <child>
                  <object class="AdwEntryRow" id="name">
                    <property name="title">Name</property>
                  </object>
                </child>
                <child>
                  <object class="AdwComboRow" id="kind">
                    <property name="title">Type</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item>Local command</item>
                          <item>Remote server</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="command">
                    <property name="title">Command</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="args">
                    <property name="title">Arguments (JSON array)</property>
                    <property name="tooltip-text">e.g. ["--port", "8080"]</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="url">
                    <property name="title">URL</property>
                    <property name="visible">false</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="requires_auth">
                    <property name="title">Requires authentication</property>
                    <property name="visible">false</property>
                  </object>
                </child>
                <child>
                  <object class="AdwExpanderRow">
                    <property name="title">Advanced</property>
                    <property name="subtitle">Optional</property>
                    <child>
                      <object class="AdwSpinRow" id="timeout">
                        <property name="title">Timeout</property>
                        <property name="subtitle">Seconds. Defaults to 300.</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">1</property>
                            <property name="upper">3600</property>
                            <property name="step-increment">10</property>
                            <property name="value">300</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwEntryRow" id="env">
                        <property name="title">Environment variables (JSON)</property>
                        <property name="tooltip-text">e.g. {"API_KEY": "secret"}</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
