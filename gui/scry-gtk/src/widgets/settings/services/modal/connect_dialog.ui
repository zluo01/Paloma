<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="ScryConnectDialog" parent="AdwDialog">
    <property name="content-width">420</property>
    <property name="content-height">300</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="GtkStack" id="stack">
            <property name="vexpand">true</property>
            <property name="transition-type">crossfade</property>

            <child>
              <object class="GtkStackPage">
                <property name="name">loading</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">16</property>
                    <property name="valign">center</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="AdwSpinner">
                        <property name="halign">center</property>
                        <property name="width-request">32</property>
                        <property name="height-request">32</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Connecting…</property>
                        <property name="halign">center</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="GtkStackPage">
                <property name="name">challenge</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">16</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">24</property>
                    <property name="margin-start">28</property>
                    <property name="margin-end">28</property>
                    <property name="valign">center</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Enter this code in your browser</property>
                        <property name="halign">center</property>
                        <style>
                          <class name="heading"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="code">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">6</property>
                        <property name="halign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="uri_label">
                        <property name="selectable">true</property>
                        <property name="halign">center</property>
                        <style>
                          <class name="caption"/>
                          <class name="dim-label"/>
                          <class name="monospace"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="open">
                        <property name="label">Open in browser</property>
                        <property name="halign">center</property>
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Waiting for approval…</property>
                        <property name="halign">center</property>
                        <style>
                          <class name="caption"/>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="GtkStackPage">
                <property name="name">manual</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">16</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">24</property>
                    <property name="margin-start">28</property>
                    <property name="margin-end">28</property>
                    <property name="valign">center</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Paste your API key</property>
                        <property name="halign">center</property>
                        <style>
                          <class name="heading"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="AdwPasswordEntryRow" id="key_entry">
                            <property name="title">API key</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="instructions">
                        <property name="label">Get an API key</property>
                        <property name="halign">center</property>
                        <property name="visible">false</property>
                        <style>
                          <class name="link"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="connect">
                        <property name="label">Connect</property>
                        <property name="halign">center</property>
                        <property name="sensitive">false</property>
                        <style>
                          <class name="pill"/>
                          <class name="suggested-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="GtkStackPage">
                <property name="name">success</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">16</property>
                    <property name="valign">center</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">✓</property>
                        <property name="halign">center</property>
                        <style>
                          <class name="scry-connect-check"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Connected</property>
                        <property name="halign">center</property>
                        <style>
                          <class name="heading"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="GtkStackPage">
                <property name="name">error</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">16</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">24</property>
                    <property name="margin-start">28</property>
                    <property name="margin-end">28</property>
                    <property name="valign">center</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Connection failed</property>
                        <property name="halign">center</property>
                        <style>
                          <class name="heading"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="error_message">
                        <property name="halign">center</property>
                        <property name="wrap">true</property>
                        <style>
                          <class name="error"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="error_close">
                        <property name="label">Close</property>
                        <property name="halign">center</property>
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
