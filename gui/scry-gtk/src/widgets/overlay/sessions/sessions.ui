<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="ScrySessions" parent="GtkBox">
    <property name="orientation">vertical</property>
    <style>
      <class name="scry-surface"/>
      <class name="scry-sessions-card"/>
    </style>
    <child>
      <object class="GtkLabel">
        <property name="label">Sessions</property>
        <property name="xalign">0</property>
        <style>
          <class name="scry-sessions-header"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow">
        <property name="hscrollbar-policy">never</property>
        <property name="vscrollbar-policy">automatic</property>
        <property name="vexpand">true</property>
        <style>
          <class name="scry-scroller"/>
        </style>
        <child>
          <object class="GtkListBox" id="list">
            <property name="selection-mode">single</property>
            <style>
              <class name="scry-sessions-list"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
